# Vellum Server Environment Example
# Copy to .env for local runs; never commit real API keys.

VELLUM_HOST=127.0.0.1
VELLUM_PORT=3001
VELLUM_DB_PATH=./data/vellum.sqlite
VELLUM_MODULES_DIR=./modules

# Runtime LLM provider mode: "mock" (V0.1-V0.3 default) or "live" (V0.4+/V1)
VELLUM_LLM_MODE=mock

# Live provider settings (used only when VELLUM_LLM_MODE=live)
# VELLUM_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
# VELLUM_LLM_API_KEY=
# VELLUM_LLM_MODEL=gpt-4o-mini

# Observability
RUST_LOG=vellum_server=debug,tower_http=info
